#!/usr/bin/env python3
import sys
if sys.version_info < (3,10):
    raise SystemExit("Python 3.10+ is required; this launcher uses "+sys.version.split()[0]+". Repair the environment with tools/workspace.py install codex-scheduler --python /path/to/python3.12.")
from pathlib import Path
app = Path(__file__).resolve().parents[1]
workspace = app.parents[1]
sys.path.insert(0,str(workspace/'packages/cli-provider-core/src'))
sys.path.insert(0,str(app))
from codex_scheduler.cli import main
sys.exit(main())
